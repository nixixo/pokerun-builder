{
  "name": "pokerunbuilder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-data.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-data.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "test": "node --import ./tests/registrar.mjs --test \"tests/**/*.test.ts\"",
    "data:pokeapi": "node scripts/generate-pokeapi-data.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "next": "16.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  }
}
